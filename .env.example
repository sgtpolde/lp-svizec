# ─────────────────────────────────────────────────────────
# Discord & Riot credentials
# ─────────────────────────────────────────────────────────
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID        # Required for slash commands
RIOT_API_KEY=YOUR_RIOT_API_KEY_HERE          # production key w/ "Match v5" + "Account v1" perms

# ─────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/lp-svizec?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────
# Bot behaviour
# ─────────────────────────────────────────────────────────
LOG_LEVEL=info                               # error | warn | info | debug
NODE_ENV=development                         # development | production

# ─────────────────────────────────────────────────────────
# Development (optional)
# ─────────────────────────────────────────────────────────
GUILD_ID=YOUR_TEST_GUILD_ID                  # For faster command deployment during dev
